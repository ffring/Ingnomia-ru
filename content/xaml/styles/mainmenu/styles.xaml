	<Style x:Key="TabButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
		<Setter Property="OverridesDefaultStyle" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Border BorderBrush="{TemplateBinding BorderBrush}"
							Background="{TemplateBinding Background}">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsChecked" Value="True">
				<Setter Property="Background" Value="{StaticResource TileInfoTabSelectedBrush}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="VirtualList" TargetType="{x:Type ItemsControl}" BasedOn="{StaticResource {x:Type ItemsControl}}">
		<Setter Property="OverridesDefaultStyle" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Border
						BorderThickness="{TemplateBinding Border.BorderThickness}"
						Padding="{TemplateBinding Control.Padding}"
						BorderBrush="{TemplateBinding Border.BorderBrush}"
						Background="{TemplateBinding Panel.Background}">
						<ScrollViewer x:Name="PART_Scroll"
							Padding="{TemplateBinding Control.Padding}"
							Focusable="False">
							<ItemsPresenter />
						</ScrollViewer>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<VirtualizingStackPanel ScrollViewer.CanContentScroll="True" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
		<Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
		<Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
	</Style>

	<!-- Tab IDs (A/T/C/I/D/J) and terrain action texts double as command parameters,
	     so the visible Russian labels are mapped here instead of in C++. -->
	<Style x:Key="TITabButtonLabelStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource TabButton}">
		<Setter Property="Content" Value="{Binding Name}"/>
		<Style.Triggers>
			<DataTrigger Binding="{Binding ID}" Value="A"><Setter Property="Content" Value="Всё"/></DataTrigger>
			<DataTrigger Binding="{Binding ID}" Value="T"><Setter Property="Content" Value="Рельеф"/></DataTrigger>
			<DataTrigger Binding="{Binding ID}" Value="C"><Setter Property="Content" Value="Существа"/></DataTrigger>
			<DataTrigger Binding="{Binding ID}" Value="I"><Setter Property="Content" Value="Предметы"/></DataTrigger>
			<DataTrigger Binding="{Binding ID}" Value="D"><Setter Property="Content" Value="Зона"/></DataTrigger>
			<DataTrigger Binding="{Binding ID}" Value="J"><Setter Property="Content" Value="Задание"/></DataTrigger>
		</Style.Triggers>
	</Style>

	<!-- TileInfo state tokens come from C++ as fixed English words; show them in Russian. -->
	<Style x:Key="TIDesignationTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
		<Setter Property="Text" Value="{Binding DesignationTitle}"/>
		<Style.Triggers>
			<DataTrigger Binding="{Binding DesignationTitle}" Value="Workshop"><Setter Property="Text" Value="Мастерская"/></DataTrigger>
			<DataTrigger Binding="{Binding DesignationTitle}" Value="Stockpile"><Setter Property="Text" Value="Склад"/></DataTrigger>

		<Setter Property="MinWidth" Value="32"/>
		<Setter Property="MinHeight" Value="28"/>
		<Setter Property="MaxWidth" Value="32"/>
		<Setter Property="MaxHeight" Value="28"/>
		<Setter Property="Margin" Value="2"/>
	</Style>

	<!-- Activity letters N/E/S/T are IDs from C++; the Russian letters are О(тдых), Е(да), С(он), У(чения). -->
	<Style x:Key="GnomeScheduleButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource GnomeScheduleHeaderButtonStyle}">
		<Setter Property="Content" Value="{Binding Activity}"/>
		<Style.Triggers>
			<DataTrigger Binding="{Binding Activity}" Value="N">
				<Setter Property="Background" Value="{StaticResource ActivityNoneBrush}"/>
				<Setter Property="Content" Value="О"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Activity}" Value="E">
				<Setter Property="Background" Value="{StaticResource ActivityEatBrush}"/>
				<Setter Property="Content" Value="Е"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Activity}" Value="S">
				<Setter Property="Background" Value="{StaticResource ActivitySleepBrush}"/>
				<Setter Property="Content" Value="С"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Activity}" Value="T">
				<Setter Property="Background" Value="{StaticResource ActivityTrainBrush}"/>
				<Setter Property="Content" Value="У"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="ScheduleActivityAllButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource GnomeSkillAllButtonStyle}">
		<Setter Property="Content" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PopulationWindow}}, Path=DataContext.ScheduleActivity }"/>
		<Style.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PopulationWindow}}, Path=DataContext.ScheduleActivity }" Value="N"><Setter Property="Content" Value="О"/></DataTrigger>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PopulationWindow}}, Path=DataContext.ScheduleActivity }" Value="E"><Setter Property="Content" Value="Е"/></DataTrigger>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PopulationWindow}}, Path=DataContext.ScheduleActivity }" Value="S"><Setter Property="Content" Value="С"/></DataTrigger>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PopulationWindow}}, Path=DataContext.ScheduleActivity }" Value="T"><Setter Property="Content" Value="У"/></DataTrigger>
		</Style.Triggers>
	</Style>

